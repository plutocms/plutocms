# The public URL of the site. Used by the OG images and by llms.txt.
NUXT_SITE_URL=
# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Pluto: the pages are Markdown files in this GitHub repository.
# Pluto finds the repository from Vercel or, in development, from the git remote.
# Set it as "owner/name" only when a build runs elsewhere (a local production build, CI).
# PLUTO_CMS_REPO=plutocms/plutocms
# The URL name of your GitHub App (github.com/apps/<slug>).
PLUTO_CMS_APP_SLUG=your-docs-cms

# Secrets. Keep them out of git.
# Do not fill these by hand. Run the dev server, open Admin > Settings > GitHub, and select
# "Create the GitHub App". Pluto saves the values here. On a deployed site, open /admin/login.
# See "Quickstart" in the docs (3.github-cms/2.quickstart.md).
# 32 characters or more. Generate one with: openssl rand -base64 32
NUXT_PLUTO_CMS_SESSION_PASSWORD=
NUXT_PLUTO_CMS_GITHUB_APP_ID=
NUXT_PLUTO_CMS_GITHUB_CLIENT_ID=
NUXT_PLUTO_CMS_GITHUB_CLIENT_SECRET=
# The private key of the GitHub App: a PEM, a PEM on one line with \n, or its base64.
# The wizard writes the base64.
NUXT_PLUTO_CMS_GITHUB_PRIVATE_KEY=
# Optional: only these GitHub logins can sign in (comma-separated).
# NUXT_PLUTO_CMS_ALLOWED_USERS=

# Development: test against GitHub instead of the local content/ folder.
# PLUTO_CMS_STORAGE=github
# Pluto development: use the local checkouts of the layers (pluto, nuxt-content, ...)
# in this folder. It is the folder that holds the checkouts, relative to this site.
# PLUTO_LOCAL_ROOT=..
# PLUTO_USE_LOCAL=false turns PLUTO_LOCAL_ROOT off.
